# Firebase Client SDK (Expo)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# DeepAR (FREE até 10 MAU) — https://developer.deepar.ai
# 1) Crie projeto Free  2) Add App (bundle/package + Web domain)
# 3) Cole a license key abaixo e reinicie o Expo
EXPO_PUBLIC_DEEPAR_LICENSE_KEY=
EXPO_PUBLIC_DEEPAR_APP_DOMAIN=localhost

# Daily.co — LIVE real (câmera host → viewers) — https://dashboard.daily.co
# 1) Crie conta free  2) Developers → API key
# 3) Cole abaixo e reinicie o Expo
EXPO_PUBLIC_DAILY_API_KEY=
# EXPO_PUBLIC_DAILY_DOMAIN=seu-subdominio.daily.co

# Firebase Admin SDK — NÃO use no app client (Expo/Vite).
# Guarde só em backend/server (Functions, API) e NUNCA com prefixo EXPO_PUBLIC_/VITE_.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
