# Supabase (Expo — use EXPO_PUBLIC_)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# LiveKit Cloud (LIVE recomendado) — https://cloud.livekit.io
# WebSocket URL do projeto (Settings → Project)
EXPO_PUBLIC_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
# Secrets da Edge Function live-token (Dashboard → Edge Functions → Secrets):
# LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...

# DeepAR (FREE até 10 MAU) — https://developer.deepar.ai
EXPO_PUBLIC_DEEPAR_LICENSE_KEY=
EXPO_PUBLIC_DEEPAR_APP_DOMAIN=localhost

# Daily.co — LIVE fallback opcional — https://dashboard.daily.co
EXPO_PUBLIC_DAILY_API_KEY=
